// =============================================================================
//  fpga_hank.cst —— Tang Mega 138K 物理约束
//  器件：GW5AST-LV138PG484AC1/I0（GW5AST-138C），封装 PBG484A
//
//  ★ 引脚值已双重核对：
//     (1) vdalex/tangmega-138k-fpga-projects 的 f_music.cst（权威参考工程）
//     (2) flow-verifier 独立用 Sipeed 板级资料交叉比对
//     (3) 9 个引脚全部经真实 P&R 编译通过（见 _verify-flow/logs）
//  ★ 注意：仅"P&R 接受"不等于"能出声" —— 必须上板实测。
//     缺 .cst 时 Gowin 不报错，会自动摆放 IO（静默错脚），务必确认本文件被加入工程。
// =============================================================================

// ---- 时钟：V22 是 50 MHz 有源晶振（同时是 EMCCLK 引脚）--------------------
// 注意：V22 走 EMCCLK，P&R 会报 PR1014（时钟走通用布线，偏斜偏大）。
// 对音频这种低频设计可接受；若将来要做高速设计需改用专用时钟脚。
IO_LOC  "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---- 板载 LED（低有效）----------------------------------------------------
// V13 无灯珠；U21 是 CPU/SSPI 专用脚，布局器会拒绝
IO_LOC  "led[0]" T18;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "led[1]" R18;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "led[2]" R17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "led[3]" P16;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// ---- 板载 PT8211 I2S DAC（3.5mm 耳机口 + 2 路 3W 扬声器）------------------
IO_LOC  "HP_BCK" Y17;
IO_PORT "HP_BCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "HP_WS" AB17;
IO_PORT "HP_WS" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "HP_DIN" AA16;
IO_PORT "HP_DIN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
// PA_EN 低有效：必须驱动 0 才出声
IO_LOC  "PA_EN" AB16;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// =============================================================================
//  板载用户按键（赛题基础要求①：≥2 个独立可控维度）
// -----------------------------------------------------------------------------
//  引脚出处：官方 Sipeed 引脚文件 tang_mega_138K_pins.cst 的 "====== Keys ======" 段：
//      IO_LOC "Key_in[0]" AB13;
//      IO_LOC "Key_in[1]" Y12;
//  两者均为 LVCMOS33 / PULL_MODE=UP / BANK_VCCIO=3.3，板上已内部上拉，
//  **按下 = 0（低有效）**。官方 Wiki 说共 3 个 User-KEY，但官方引脚文件只给出
//  这两个球号；第三个键物理存在（DOCK 原理图有 EX_KEY.0/1/2 网络名）但无球号映射，
//  故本工程只用两个 —— 已足够满足"≥2 维"。
//
//  ⚠️ 不要用 F4：F4 在 1.5V bank（LVCMOS15 / BANK_VCCIO=1.5），
//     混进本工程全 LVCMOS33 的约束里会多一处失败可能。
//
//  用途：
//    key  (AB13) = 交互维度 1：演奏触发（按住 = 32 路齐发，松开 = 释放）
//    key2 (Y12)  = 交互维度 2：音色切换（每按一下在 4 种波形表间循环）
// =============================================================================
IO_LOC  "key" AB13;
IO_PORT "key" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC  "key2" Y12;
IO_PORT "key2" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
// =============================================================================
//  自研变调键（交互维度 3）—— PMOD 排针 P19
// -----------------------------------------------------------------------------
//  赛题基础要求③要求「支持单音实时变调」。官方按键只有两个（Keys 段只给
//  AB13/Y12），因此第三个控制维度用 PMOD 排针外接一个按键，这正是赛题要求的
//  "自研交互形态"（不买现成键盘，自己接一个按钮）。
//
//  接法：P19 与 GND 之间接一个常开按键。IO 内部开上拉，按下 = 0
//        （与板载按键极性一致，便于统一处理）。
//  ⚠️ 未接按键时该脚被内部上拉为高 ⇒ pitch_semi 恒为 0（原调），
//     不影响其它功能，也不影响测试模式的 32 谱峰取证。
//
//  P19 出处：Sipeed 官方 pmod_led 例程的 PMOD 引脚表
//      P19 R19 T21 U21 Y21 Y22 AB21 AB22 AA20 AA21 AA19 AB20 R17 R18 T18 P16
//  其中 U21 已实测【不可用】（PR2017 CPU/SSPI 专用脚），故不选它。
// =============================================================================
IO_LOC  "key_pitch" Y22;
IO_PORT "key_pitch" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// =============================================================================
//  串口接收（2026-10-05 新增）—— 电脑控制链路，MODE=1 用
// -----------------------------------------------------------------------------
//  引脚出处：官方引脚文件 tang_mega_138K_pins.cst 的 "====== UART ======" 段：
//      IO_LOC  "txp"           U15;    // FPGA 发出（→PC）【固定，无版本差异】
//      //For Version 31004 or later
//      IO_LOC  "rxp"           V14;    // FPGA 接收（←PC）  新版板子
//      //For Version 31002
//      //IO_LOC  "rxp"         Y14;    // FPGA 接收         旧版板子
//  三处官方来源相互印证（引脚文件 + ddr_memory_test_uart 的 ddr3_1v4_hs.cst
//  + riscv_hdmi.cst 均写 uart_tx=U15 / uart_rx=V14）。
//
//  ★ 2026-10-05 上板确证（两个独立实现交叉验证）：
//      FPGA UART = **COM9**（FT2232H 通道 B）；**V14 正确**；双向全通
//      （发 90 45 64 → 收 90 45 64 完全一致）。Y14 无需再试。
//      COM8 = 通道 A（JTAG），只有伪回显噪声（FA 注入），**不是 FPGA UART**。
//
//  🔴 **`rxp` 不能带 DRIVE**（本工程 P&R 实测）：
//      官方引脚文件给 rxp 写了 DRIVE=8，但本器件/版本直接报
//        ERROR (CT1108): Illegal port attribute value specified 'DRIVE = 8' on 'rxp'
//      ⇒ 去掉 DRIVE 后立刻通过。这与"它是输入脚"一致。
//      （`txp` 可以带 DRIVE=8；本工程 MODE=1/2 不需要发送，故未引出 txp。）
//
//  ⚠️ 注意：本工程只用 `rxp`（接收）。FPGA 侧**没有 TX 通路**
//      ⇒ 不存在"发送忙吞掉接收字节"的问题（集成清单 §12 的裁决依据）。
// =============================================================================
IO_LOC  "uart_rx_pin" V14;
IO_PORT "uart_rx_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// =============================================================================
//  S5 硬件乐器输入（MODE=3）—— J13（SDRAM0 座，3.3V IO）+ J8 I2C + J9 调试口
//  球号来源：hw_bringup/constr/hw_inputs.cst（2026-10-22 真板 P&R + 实测通过）
//  ⚠️ J13 第 11 脚 = 5V_Peripheral，绝对不约束不接线。
//  photo 2..5 未接线：PULL_MODE=UP 保持稳定高，防止遥测位翻转。
// =============================================================================
IO_LOC  "key_hw[0]" E14;
IO_PORT "key_hw[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "key_hw[1]" E13;
IO_PORT "key_hw[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "key_hw[2]" C15;
IO_PORT "key_hw[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "key_hw[3]" C14;
IO_PORT "key_hw[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "key_hw[4]" B13;
IO_PORT "key_hw[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "key_hw[5]" C13;
IO_PORT "key_hw[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "key_hw[6]" A14;
IO_PORT "key_hw[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "key_hw[7]" A13;
IO_PORT "key_hw[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "key_hw[8]" B16;
IO_PORT "key_hw[8]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "key_hw[9]" B15;
IO_PORT "key_hw[9]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "key_hw[10]" A16;
IO_PORT "key_hw[10]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "key_hw[11]" A15;
IO_PORT "key_hw[11]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "key_hw[12]" A20;
IO_PORT "key_hw[12]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC  "photo_hw[0]" B20;
IO_PORT "photo_hw[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "photo_hw[1]" A21;
IO_PORT "photo_hw[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "photo_hw[2]" B21;
IO_PORT "photo_hw[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "photo_hw[3]" B18;
IO_PORT "photo_hw[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "photo_hw[4]" B17;
IO_PORT "photo_hw[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "photo_hw[5]" C17;
IO_PORT "photo_hw[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC  "ec1a" D17;
IO_PORT "ec1a" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "ec1b" A19;
IO_PORT "ec1b" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ToF #1 I2C 总线 A（J8-10 / J8-11；外部 4.7k 上拉 + 330R 串联已接）
IO_LOC  "scl_tof" A18;
IO_PORT "scl_tof" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=2 BANK_VCCIO=3.3;
IO_LOC  "sda_tof" D15;
IO_PORT "sda_tof" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=2 BANK_VCCIO=3.3;

// 调试遥测 TX（J9-11 = P19，CPU 专用脚：build_60k.tcl 已加 -use_cpu_as_gpio 1）
IO_LOC  "dbg_tx" P19;
IO_PORT "dbg_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;