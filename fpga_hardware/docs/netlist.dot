// 硬件连接图（Graphviz）。渲染：
//   dot -Tsvg netlist.dot -o netlist.svg
//   或在线粘贴到 https://dreampuf.github.io/GraphvizOnline/
digraph netlist {
  graph [rankdir=LR, fontname="Microsoft YaHei", fontsize=11, nodesep=0.22, ranksep=0.75,
         label="Tang Mega 60K · 硬件乐器（MODE=3）连接网表 · 2026-10-24\n位流 MODE3_mode3_60K_20261024-012557（User Code 0x1A2B0003）",
         labelloc=t, bgcolor="white"];
  node  [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=9,
         fillcolor="#eef3fb", color="#7a9cc6"];
  edge  [fontname="Consolas", fontsize=8, color="#4a6fa5"];

  FPGA [label="GW5AT-60B\nTang Mega 60K\n(SOM + 底板)", shape=box3d,
        fillcolor="#d7e6ff", fontsize=11, penwidth=1.6];

  // ---------------- 输入：13 键 ----------------
  subgraph cluster_keys {
    label="四脚轻触开关 ×13 → J13-1..10,13,14,15";
    style="rounded,dashed"; color="#9db8d9"; fontsize=9;
    node [fillcolor="#f7fbff"];
    K1  [label="键1  C4"];  K2  [label="键2  C#4"]; K3  [label="键3  D4"];
    K4  [label="键4  D#4"]; K5  [label="键5  E4"];  K6  [label="键6  F4"];
    K7  [label="键7  F#4"]; K8  [label="键8  G4"];  K9  [label="键9  G#4"];
    K10 [label="键10 A4"];  K11 [label="键11 A#4"]; K12 [label="键12 B4"];
    K13 [label="键13 C5"];
  }

  // ---------------- 输入：光电 ----------------
  subgraph cluster_photo {
    label="光电 E3F-20C1（12V）→ S9012 → J13-16";
    style="rounded,dashed"; color="#9db8d9"; fontsize=9;
    PWR12 [label="+12V / 0V\n(外部 ≥2A)", fillcolor="#ffe8e8", color="#c66"];
    PH    [label="光电 #1\n黑线 0↔12V", fillcolor="#fff4e6", color="#d90"];
    S9012 [label="S9012 射随器\n未挡3.3V / 挡0.6V", fillcolor="#fff4e6", color="#d90"];
  }

  // ---------------- 输入：EC11 ----------------
  EC11 [label="EC11 #1\nA/B 正交", fillcolor="#f0fff4", color="#4a8"];
  EC11C [label="C 悬空（公共端）", style="dashed", fillcolor="#fafafa", color="#aaa"];

  // ---------------- IO：ToF ----------------
  subgraph cluster_tof {
    label="ToF VB22B（I2C 0x52, 10 kHz）";
    style="rounded,dashed"; color="#9db8d9"; fontsize=9;
    TOF   [label="ToF #1\nVCC/GND/SCL/SDA", fillcolor="#f0f8ff"];
    PULL  [label="4.7k×2 上拉→3V3\n330Ω×2 串联", fillcolor="#f0f8ff"];
  }

  // ---------------- 输出 ----------------
  subgraph cluster_audio {
    label="板载音频";
    style="rounded,dashed"; color="#9db8d9"; fontsize=9;
    DAC [label="PT8211\nI2S DAC", fillcolor="#eef7ee", color="#5a5"];
    AMP [label="功放 PA_EN\n(低有效=常开)", fillcolor="#eef7ee", color="#5a5"];
    JACK[label="3.5mm 耳机 / 喇叭", fillcolor="#eef7ee", color="#5a5"];
  }
  UART [label="USB-TTL (CH340)\nCOM12 · 115200", fillcolor="#f5f0ff", color="#75a"];
  PC   [label="PC\nCOM19 MIDI", shape=box, fillcolor="#f5f0ff", color="#75a"];

  // ---------------- 网络：输入 ----------------
  K1  -> FPGA [label="E14 J13-1"];   K2  -> FPGA [label="E13 J13-2"];
  K3  -> FPGA [label="C15 J13-3"];   K4  -> FPGA [label="C14 J13-4"];
  K5  -> FPGA [label="B13 J13-5"];   K6  -> FPGA [label="C13 J13-6"];
  K7  -> FPGA [label="A14 J13-7"];   K8  -> FPGA [label="A13 J13-8"];
  K9  -> FPGA [label="B16 J13-9"];   K10 -> FPGA [label="B15 J13-10"];
  K11 -> FPGA [label="A16 J13-13"];  K12 -> FPGA [label="A15 J13-14"];
  K13 -> FPGA [label="A20 J13-15"];

  PWR12 -> PH [style=dashed, label="棕/蓝"];
  PH    -> S9012 [label="黑线→47k"];
  S9012 -> FPGA  [label="B20 J13-16\nphoto_hw[0]"];

  EC11  -> FPGA [label="D17 J13-22 (A)\nA19 J13-23 (B)"];
  EC11  -> EC11C [style=dotted, arrowhead=none];

  TOF   -> PULL  [style=dotted, arrowhead=none];
  TOF   -> FPGA  [dir=both, label="SCL A18 J13-24\nSDA D15 J13-25\n(DRIVE=2)"];

  // ---------------- 网络：输出 ----------------
  FPGA -> DAC  [label="Y17 AB17 AA16\nBCK/WS/DIN"];
  FPGA -> AMP  [label="AB16 PA_EN"];
  DAC  -> JACK [label="模拟"];
  AMP  -> JACK [style=dashed];
  FPGA -> UART [label="P19 J9-11"]; 
  PC   -> FPGA [label="V14 uart_rx"];

  // ---------------- 说明 ----------------
  NOTE [shape=note, fillcolor="#fffbe6", color="#d4b106", fontsize=8,
        label="要点：\n• J13-11 = 5V，绝不能接\n• I2C 固定 J13-24/25（J8 与音频同 BANK7）\n• 1.5V bank 脚：AB13 / Y12\n• 12V 永不进 FPGA"];
  FPGA -> NOTE [style=invis];
}
