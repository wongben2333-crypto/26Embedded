[options]
mode bmc
depth 20
# 若要穷尽证明（而非有界检查）改成： mode prove

[engines]
smtbmc z3

[script]
read_verilog -formal acc_overflow_fv.v
prep -top acc_overflow_fv

[files]
acc_overflow_fv.v
