function cn_text_pixel;
    input [5:0] str_id;
    input [9:0] curr_x, curr_y;
    input [9:0] start_x, start_y;
    input [1:0] scale; // 1: 16x16, 2: 32x32
    reg [9:0] rx, ry;
    reg [4:0] char_idx;
    reg [4:0] s_len;
    reg [7:0] ch_id;
    reg [4:0] c_col;
    reg [3:0] c_row;
    begin
        cn_text_pixel = 1'b0;
        s_len = get_cn_str_len(str_id);
        if (curr_x >= start_x && curr_y >= start_y) begin
            rx = (scale == 2'd2) ? ((curr_x - start_x) >> 1) : (curr_x - start_x);
            ry = (scale == 2'd2) ? ((curr_y - start_y) >> 1) : (curr_y - start_y);
            if (ry < 10'd16 && rx < ({5'd0, s_len} * 10'd18)) begin
                // char width = 16, spacing = 2 -> period = 18
                char_idx = (rx * 22'd228) >> 12; // rx / 18
                c_col = rx - (char_idx * 10'd18);
                c_row = ry[3:0];
                if (c_col < 5'd16) begin
                    ch_id = get_cn_char(str_id, char_idx);
                    if (ch_id != 8'd255) begin
                        cn_text_pixel = cn_font_dot(ch_id, c_col[3:0], c_row);
                    end
                end
            end
        end
    end
endfunction