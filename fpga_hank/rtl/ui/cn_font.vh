            6'd9: get_cn_str_len = 5'd8;
            6'd10: get_cn_str_len = 5'd2;
            6'd11: get_cn_str_len = 5'd4;
            6'd12: get_cn_str_len = 5'd4;
            6'd13: get_cn_str_len = 5'd5;
            6'd14: get_cn_str_len = 5'd7;
            6'd15: get_cn_str_len = 5'd5;
            6'd16: get_cn_str_len = 5'd5;
            6'd17: get_cn_str_len = 5'd7;
            6'd18: get_cn_str_len = 5'd6;
            6'd19: get_cn_str_len = 5'd9;
            6'd20: get_cn_str_len = 5'd9;
            6'd21: get_cn_str_len = 5'd9;
            6'd22: get_cn_str_len = 5'd12;
            6'd23: get_cn_str_len = 5'd9;
            6'd24: get_cn_str_len = 5'd7;
            6'd25: get_cn_str_len = 5'd9;
            6'd26: get_cn_str_len = 5'd2;
            6'd27: get_cn_str_len = 5'd3;
            6'd28: get_cn_str_len = 5'd3;
            6'd29: get_cn_str_len = 5'd3;
            6'd30: get_cn_str_len = 5'd3;
            6'd31: get_cn_str_len = 5'd3;
            6'd32: get_cn_str_len = 5'd2;
            6'd33: get_cn_str_len = 5'd2;
            6'd34: get_cn_str_len = 5'd2;
            6'd35: get_cn_str_len = 5'd2;
            6'd36: get_cn_str_len = 5'd8;
