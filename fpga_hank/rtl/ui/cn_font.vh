function [7:0] get_cn_char;
    input [5:0] str_id;
    input [4:0] idx;
    begin
        case (str_id)
            6'd0: case (idx) // "演奏"
                5'd0: get_cn_char = 8'd0; // '演'
                5'd1: get_cn_char = 8'd1; // '奏'
                default: get_cn_char = 8'd255;
            endcase
            6'd1: case (idx) // "示波"
                5'd0: get_cn_char = 8'd2; // '示'
                5'd1: get_cn_char = 8'd3; // '波'
                default: get_cn_char = 8'd255;
