function [4:0] get_cn_str_len;
    input [5:0] str_id;
    begin
        case (str_id)
            6'd0: get_cn_str_len = 5'd2;
            6'd1: get_cn_str_len = 5'd2;
            6'd2: get_cn_str_len = 5'd2;
