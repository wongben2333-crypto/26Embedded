// =============================================================================
//  smoke.cst —— 分级冒烟测试（rtl/smoke_top.v）的物理约束
//  板卡：Sipeed Tang Mega 138K Dock
//  器件：GW5AST-LV138PG484AC1/I0（GW5AST-138C），封装 PBG484A
//
//  ★ 全部引脚都来自本地 _refs/ 下的官方例程真实 .cst，不是凭记忆猜的：
//      clk / led[0..3] / HP_* / PA_EN
//          → _refs/sipeed-pinout/audio.cst、_refs/tangmega-fpga-projects/fractal_music.cst
//      key (AB13)  = LVCMOS33 / PULL_MODE=UP / BANK_VCCIO=3.3
//          → _refs/sipeed-138k/pwm_fan/eda_proj/src/eda_proj.cst  L12  (key_in)
//          → _refs/sipeed-138k/joycon/src/Joycon.cst              L5   (rst_n)
//      DBG_KEY (Y22) / DBG_GATE (AB21) / DBG_AUDIO (AB22)
//          → _refs/sipeed-pinout/pmod_led_eda_proj.cst（官方 pmod_led 例程把
//             Y22/Y21/AB22/AB21 当 led[8]/led[9]/led[10]/led[11] 驱动【外部】
//             PMOD-LED 模块，即它们确实接到可插拔排针上；同一组脚在 dock.cst
//             里是 DVP 摄像头接口。这些例程是 device version B 的工程。）
//
//  ★★ 实测（本机 GW5AST-138C / PBG484A，一次 14 脚 P&R 探针，见
//     _smoke-test/probe_pins/ 与 REPORT.md）：以下"官方例程用过"的脚
//     在 **device version C 上是 CPU/SSPI 专用脚，布局器直接拒绝**：
//         Y21  → ERROR (PR2017) dedicated pin (SSPI)
//         U21  → ERROR (PR2017) dedicated pin (CPU/SSPI)   ← AGENTS.md 是对的
//         T21  → ERROR (PR2017) dedicated pin (CPU)
//         R19  → ERROR (PR2017) dedicated pin (CPU/SSPI)
//         P19  → ERROR (PR2017) dedicated pin (CPU/SSPI)
//     ⇒ 所以 DBG_GATE 从 Y21 改到 **AB21**。
//     ⇒ dock.cst / Joycon.cst 里把 U21 当 state_led[4] 的写法【在本板版本上不能用】。
//     探针确认可用的输出脚：Y22 AB22 AB21 AA21 T14 J16 W21 H20 G20。
//
//  ⚠️ key 用 AB13，【不要】用 F4：F4 在 1.5V bank（LVCMOS15 / BANK_VCCIO=1.5），
//     混进这一堆 LVCMOS33 里会多一处失败可能。
//     板上还有 2 个 User-KEY，引脚号官方 Wiki 说有但本地例程里找不到 → 未使用。
//
//  ⚠️ 三个 DBG_* 是【打标脚】，只在 S6（延迟测量）和 S0（方波定位）里有意义。
//     如果用户暂时不想用示波器，它们不会影响 S1–S5 的任何功能。
//
//  ★ 缺 .cst 时 Gowin 不报错，会静默自动摆放 IO（错脚但"构建成功"）。
//    构建脚本 build_smoke.tcl 会打印每个端口的落位与"是否被 .cst 约束"，
//    见到 Constraint=N 就是没约束上。
// =============================================================================

// ---- 时钟：V22 = 50 MHz 板载有源晶振（同时是 EMCCLK，P&R 会报 PR1014）------
IO_LOC  "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// ---- 用户按键：AB13(Key_in[0]) / Y12(Key_in[1])，板上已有上拉，按下 = 0 ----
// 引脚出处：官方 Sipeed 引脚文件 tang_mega_138K_pins.cst 的 "====== Keys ======" 段，
// 该段【只有这两个键】，两个都是 LVCMOS33 / 3.3V / PULL_UP：
//     IO_LOC "Key_in[1]" Y12;
//     IO_LOC "Key_in[0]" AB13;
// 官方 pwm_fan 例程（key_in=AB13）、joycon 例程（rst_n=AB13）也印证了 AB13。
// 内部再开 PULL_MODE=UP 是双保险。
IO_LOC  "key" AB13;
IO_PORT "key" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "key2" Y12;
IO_PORT "key2" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---- 板载 LED（低有效，驱动 0 点亮）----------------------------------------
IO_LOC  "led[0]" T18;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led[1]" R18;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led[2]" R17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led[3]" P16;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ---- 板载 PT8211 I2S DAC（3.5mm 耳机口 + 2 路 3W 扬声器座）------------------
IO_LOC  "HP_BCK" Y17;
IO_PORT "HP_BCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "HP_WS" AB17;
IO_PORT "HP_WS" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "HP_DIN" AA16;
IO_PORT "HP_DIN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// PA_EN 低有效：驱动 0 才出声
IO_LOC  "PA_EN" AB16;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ---- 延迟测量打标脚（S6）----------------------------------------------------
// 三个脚都按"输出"用，DRIVE=8 足够驱动示波器 1MΩ 探头与一只 LED+1kΩ 电阻。
IO_LOC  "DBG_KEY" Y22;
IO_PORT "DBG_KEY" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "DBG_GATE" AB21;
IO_PORT "DBG_GATE" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "DBG_AUDIO" AB22;
IO_PORT "DBG_AUDIO" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
