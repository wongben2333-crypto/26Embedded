// ============================================================================
// Module Name: lcd_test_top
// Description: Test pattern generator for ALIENTEK ATK-MD0700 7-inch RGB LCD
//              (SSD1963 Controller, 800x480, 16-bit 8080 parallel interface)
// Target Board: Sipeed Tang Mega 138K NEO Dock (GW5AST-LV138PG484AC1/I0 = 138C, PBGA484A)
// Features:
//   1. Hardware Reset sequence (20ms LOW, 40ms HIGH)
//   2. Closed-loop 8080 bus PID readback verification (CMD 0xA1 -> PID 0x61, reads all 5 bytes)
//   3. Exact ALIENTEK official initialization sequence (PLL, Soft Reset, Exit Sleep 0x11,
//      Pixel Clock 33MHz, Timings, 16-bit 565, Display ON, Backlight PWM 100%, GPIO)
//   4. Clean Frame Loop: ONLY sets address window (0x2A, 0x2B) and Memory Write (0x2C)
//      - NO redundant 0xBE (PWM) resets during frame refresh
//      - NO 0xA1 interrupts during frame refresh
//   5. Color Cycling Test Pattern: White -> Red -> Green -> Blue (changes every 16 frames)
//   6. WS2812B visual feedback:
//      - Flashing RED/BLUE/YELLOW = PID mismatch / bus issue
//      - Rainbow Cycle            = SSD1963 verified (0x61) + Active Frame Streaming!
// ============================================================================

module lcd_test_top (
    input  wire        sys_clk,    // 50MHz on-board clock (V22)
    input  wire        sys_rst_n,  // Reserved
    
    // LCD 8080 Interface Pins (Dock J13 Connector)
    output reg         lcd_cs,     // E14 (J13 Pin 1)
    output reg         lcd_rs,     // E13 (J13 Pin 2, 0=CMD, 1=DAT)
    output reg         lcd_wr,     // C15 (J13 Pin 3, Active LOW write pulse)
    output reg         lcd_rd,     // C14 (J13 Pin 4, Active LOW read pulse)
    output reg         lcd_rst,    // B13 (J13 Pin 5, Active LOW reset)
    inout  wire [15:0] lcd_db,     // 16-bit bi-directional data bus (RGB565)

    // 板载 WS2812B 状态灯（U15，球位 J16，位于板子右下角）
    output wire        ws_dout
);

    // ------------------------------------------------------------------------
    // Bi-directional Data Bus Tri-state Driver
    // ------------------------------------------------------------------------
    reg  [15:0] lcd_db_out;
    reg         lcd_db_oe; // 1 = FPGA drives bus, 0 = High-Z (Read from SSD1963)
    wire [15:0] lcd_db_in = lcd_db;
    assign lcd_db = lcd_db_oe ? lcd_db_out : 16'hzzzz;

    // ------------------------------------------------------------------------
    // Internal Power-On Reset Generator (Self-recovering, ~10ms at 50MHz)
    // ------------------------------------------------------------------------
    reg [19:0] por_cnt = 20'd0;
    wire rst_n = por_cnt[19]; // released after ~10.5ms
    always @(posedge sys_clk) begin
        if (!por_cnt[19]) por_cnt <= por_cnt + 1'b1;
    end

    // ------------------------------------------------------------------------
    // Status Registers
    // ------------------------------------------------------------------------
    reg init_done_reg;
    reg frame_pulse_reg;
    reg wr_activity_reg;

    // ------------------------------------------------------------------------
    // PID & Power-Mode Readback Registers
    // ------------------------------------------------------------------------
    reg [2:0]  read_idx;
    reg [7:0]  pid_byte0;     // SSL high byte (0x01)
    reg [7:0]  pid_byte1;     // SSL low byte  (0x57)
    reg [7:0]  pid_byte2;     // Product ID    (0x61)
    reg [7:0]  pid_byte3;     // Revision code (0x01)
    reg [7:0]  pid_byte4;     // Exit code     (0xFF)
    reg [7:0]  detected_pid;
    reg        pid_match;
    reg [7:0]  power_mode_reg; // CMD 0x0A readback (expected 0x1C when Sleep OFF & Display ON)

    // ------------------------------------------------------------------------
    // WS2812 状态指示（板载 U15）
    // ------------------------------------------------------------------------
    reg [24:0] blink_cnt;
    always @(posedge sys_clk or negedge rst_n) begin
        if (!rst_n) blink_cnt <= 25'd0;
        else        blink_cnt <= blink_cnt + 1'b1;
    end

    reg [5:0] frame_cnt;   // 帧计数

    // WS2812 颜色顺序是 GRB：{G[7:0], R[7:0], B[7:0]}
    reg [23:0] ws_color;
    always @(*) begin
        if (!pid_match) begin
            // 8080 总线读取 PID 失败！以 ~3Hz 频率快闪报警
            if (blink_cnt[23]) begin
                if (detected_pid == 8'hFF) begin
                    // 全 1：总线高阻浮空 -> 杜邦线未接通、引脚错位或掉电
                    ws_color = 24'h00_80_00; // 纯红闪烁 (Red)
                end else if (detected_pid == 8'h00) begin
                    // 全 0：总线接地或短路
                    ws_color = 24'h00_00_80; // 纯蓝闪烁 (Blue)
                end else begin
                    // 读到了其他非 0x61 数据
                    ws_color = 24'h40_80_00; // 橙黄闪烁 (Orange/Yellow)
                end
            end else begin
                ws_color = 24'h00_00_00; // 灭
            end
        end else if (init_done_reg) begin
            // PID 匹配成功 (0x61)，且初始化完成，正在刷帧！七彩流动
            case (frame_cnt[5:3])
                3'd0:    ws_color = 24'h40_00_00;  // 绿
                3'd1:    ws_color = 24'h40_40_00;  // 黄
                3'd2:    ws_color = 24'h00_00_40;  // 蓝
                3'd3:    ws_color = 24'h00_40_40;  // 青
                3'd4:    ws_color = 24'h40_00_40;  // 紫
                3'd5:    ws_color = 24'h40_40_40;  // 白
                default: ws_color = 24'h20_50_00;  // 青绿
            endcase
        end else begin
            // PID 匹配成功，正在复位/初始化延时
            ws_color = 24'h20_00_00; // 暗绿
        end
    end

    ws2812_drv u_ws2812 (
        .clk   (sys_clk),
        .rst_n (rst_n),
        .color (ws_color),
        .dout  (ws_dout)
    );

    // ------------------------------------------------------------------------
    // Delay Counter (Controlled solely by delay_load_en & delay_load_val)
    // sys_clk = 50MHz, 1 cycle = 20ns
    // 50,000 cycles = 1ms
    // ------------------------------------------------------------------------
    reg [23:0] delay_cnt;
    reg [23:0] delay_load_val;
    reg        delay_load_en;
    reg        delay_armed;
    wire       delay_done = delay_armed && (delay_cnt == 24'd0);

    always @(posedge sys_clk or negedge rst_n) begin
        if (!rst_n) begin
            delay_cnt <= 24'd0;
        end else if (delay_load_en) begin
            delay_cnt <= delay_load_val;
        end else if (delay_cnt > 24'd0) begin
            delay_cnt <= delay_cnt - 1'b1;
        end
    end

    always @(posedge sys_clk or negedge rst_n) begin
        if (!rst_n)                  delay_armed <= 1'b0;
        else if (delay_load_en)      delay_armed <= 1'b1;
        else if (delay_cnt == 24'd0) delay_armed <= 1'b0;
    end

    // ------------------------------------------------------------------------
    // Initialization Sequence ROM Table (Full ATK-MD0700 Official Sequence
    // + Soft-Start Backlight PWM to Prevent 5V DuPont Inrush Droop)
    // Entry format: [31:0]
    // bit[31]: is_delay (1 = wait delay_cycles, 0 = bus write)
    // bit[30]: rs (0 = CMD, 1 = DAT)
    // bit[23:0]: data or delay cycle count
    // ------------------------------------------------------------------------
    localparam INIT_LEN = 65;
    reg [6:0]  init_idx;
    reg [31:0] init_rom [0:INIT_LEN-1];

    initial begin
        // 0..3: Set PLL MN (CMD 0xE2, 0x1D, 0x02, 0x04) -> VCO = 10MHz * 30 / 3 = 100MHz
        init_rom[0]  = {1'b0, 1'b0, 30'h00E2};
        init_rom[1]  = {1'b0, 1'b1, 30'h001D};
        init_rom[2]  = {1'b0, 1'b1, 30'h0002};
        init_rom[3]  = {1'b0, 1'b1, 30'h0004};
        // 4: Delay 1ms (50,000 cycles)
        init_rom[4]  = {1'b1, 1'b0, 30'd50000};
        // 5..6: Enable PLL (CMD 0xE0, 0x01)
        init_rom[5]  = {1'b0, 1'b0, 30'h00E0};
        init_rom[6]  = {1'b0, 1'b1, 30'h0001};
        // 7: Delay 10ms (500,000 cycles)
        init_rom[7]  = {1'b1, 1'b0, 30'd500000};
        // 8..9: Lock PLL (CMD 0xE0, 0x03)
        init_rom[8]  = {1'b0, 1'b0, 30'h00E0};
        init_rom[9]  = {1'b0, 1'b1, 30'h0003};
        // 10: Delay 12ms (600,000 cycles)
        init_rom[10] = {1'b1, 1'b0, 30'd600000};
        // 11: Software Reset (CMD 0x01)
        init_rom[11] = {1'b0, 1'b0, 30'h0001};
        // 12: Delay 10ms (500,000 cycles)
        init_rom[12] = {1'b1, 1'b0, 30'd500000};
        // 13: Exit Sleep Mode (CMD 0x11)
        init_rom[13] = {1'b0, 1'b0, 30'h0011};
        // 14: Delay 20ms (1,000,000 cycles)
        init_rom[14] = {1'b1, 1'b0, 30'd1000000};
        // 15..18: Set LCD Pixel Clock LSHIFT (CMD 0xE6, 0x03, 0xFF, 0xFF)
        // Per SSD1963 datasheet p.76: LCDC_FPR is 20-bit [19:0].
        // 0x03FFFF -> PCLK = 100MHz * 262144 / 1048576 = 25.0MHz (leaves 75% SRAM bandwidth for 0x2C writes!)
        init_rom[15] = {1'b0, 1'b0, 30'h00E6};
        init_rom[16] = {1'b0, 1'b1, 30'h0003};
        init_rom[17] = {1'b0, 1'b1, 30'h00FF};
        init_rom[18] = {1'b0, 1'b1, 30'h00FF};
        // 19..26: Set LCD Mode (CMD 0xB0, 0x20, 0x00, 0x03, 0x1F, 0x01, 0xDF, 0x00)
        init_rom[19] = {1'b0, 1'b0, 30'h00B0};
        init_rom[20] = {1'b0, 1'b1, 30'h0020};
        init_rom[21] = {1'b0, 1'b1, 30'h0000};
        init_rom[22] = {1'b0, 1'b1, 30'h0003}; // 799 high byte
        init_rom[23] = {1'b0, 1'b1, 30'h001F}; // 799 low byte
        init_rom[24] = {1'b0, 1'b1, 30'h0001}; // 479 high byte
        init_rom[25] = {1'b0, 1'b1, 30'h00DF}; // 479 low byte
        init_rom[26] = {1'b0, 1'b1, 30'h0000};
        // 27..35: Set Horizontal Period (CMD 0xB4, 0x04, 0x1F, 0x00, 0x2E, 0x00, 0x00, 0x00, 0x00)
        init_rom[27] = {1'b0, 1'b0, 30'h00B4};
        init_rom[28] = {1'b0, 1'b1, 30'h0004};
        init_rom[29] = {1'b0, 1'b1, 30'h001F};
        init_rom[30] = {1'b0, 1'b1, 30'h0000};
        init_rom[31] = {1'b0, 1'b1, 30'h002E};
        init_rom[32] = {1'b0, 1'b1, 30'h0000};
        init_rom[33] = {1'b0, 1'b1, 30'h0000};
        init_rom[34] = {1'b0, 1'b1, 30'h0000};
        init_rom[35] = {1'b0, 1'b1, 30'h0000};
        // 36..43: Set Vertical Period (CMD 0xB6, 0x02, 0x0C, 0x00, 0x17, 0x16, 0x00, 0x00)
        init_rom[36] = {1'b0, 1'b0, 30'h00B6};
        init_rom[37] = {1'b0, 1'b1, 30'h0002};
        init_rom[38] = {1'b0, 1'b1, 30'h000C};
        init_rom[39] = {1'b0, 1'b1, 30'h0000};
        init_rom[40] = {1'b0, 1'b1, 30'h0017};
        init_rom[41] = {1'b0, 1'b1, 30'h0016};
        init_rom[42] = {1'b0, 1'b1, 30'h0000};
        init_rom[43] = {1'b0, 1'b1, 30'h0000};
        // 44..45: Set Pixel Interface 16-bit 565 (CMD 0xF0, 0x03)
        init_rom[44] = {1'b0, 1'b0, 30'h00F0};
        init_rom[45] = {1'b0, 1'b1, 30'h0003};
        // 46: Set Display ON (CMD 0x29)
        init_rom[46] = {1'b0, 1'b0, 30'h0029};
        // 47..48: Set DBC Config (CMD 0xD0, 0x00) -> DBC Disabled
        init_rom[47] = {1'b0, 1'b0, 30'h00D0};
        init_rom[48] = {1'b0, 1'b1, 30'h0000};
        // 49..51: Set GPIO Conf (CMD 0xB8, 0x03, 0x01) -> GPIO0/1 output
        init_rom[49] = {1'b0, 1'b0, 30'h00B8};
        init_rom[50] = {1'b0, 1'b1, 30'h0003};
        init_rom[51] = {1'b0, 1'b1, 30'h0001};
        // 52..53: Set GPIO Value (CMD 0xBA, 0x01) -> GPIO0=1 (LCD panel DISP/L-R=1)
        init_rom[52] = {1'b0, 1'b0, 30'h00BA};
        init_rom[53] = {1'b0, 1'b1, 30'h0001};
        // 54..55: Orientation (CMD 0x36, 0x00) -> Landscape Left-to-Right, Top-to-Bottom
        init_rom[54] = {1'b0, 1'b0, 30'h0036};
        init_rom[55] = {1'b0, 1'b1, 30'h0000};
        // 56..62: Set Backlight PWM (CMD 0xBE, 0x01, 0x18, 0x01, 0x00, 0x00, 0x00)
        // Proven 5V-DuPont-safe duty (0x18 = ~10% at high freq PWMF=0x01) that lights panel without 5V brownout!
        init_rom[56] = {1'b0, 1'b0, 30'h00BE};
        init_rom[57] = {1'b0, 1'b1, 30'h0001};
        init_rom[58] = {1'b0, 1'b1, 30'h0018};
        init_rom[59] = {1'b0, 1'b1, 30'h0001};
        init_rom[60] = {1'b0, 1'b1, 30'h0000};
        init_rom[61] = {1'b0, 1'b1, 30'h0000};
        init_rom[62] = {1'b0, 1'b1, 30'h0000};
        // 63: Set Display ON (CMD 0x29)
        init_rom[63] = {1'b0, 1'b0, 30'h0029};
        // 64: Delay 10ms before starting first frame (500,000 cycles)
        init_rom[64] = {1'b1, 1'b0, 30'd500000};
    end

    // ------------------------------------------------------------------------
    // Frame Address Window Commands ROM (0x2A, 0x2B, 0x2C)
    // ONLY Window coordinates and Memory Write Start! Clean & Standard!
    // ------------------------------------------------------------------------
    localparam FRAME_CMD_LEN = 11;
    reg [3:0]  frame_cmd_idx;
    reg [17:0] frame_cmd_rom [0:FRAME_CMD_LEN-1];

    initial begin
        // 0..4: Set Column Address 0..799 (0x0000 .. 0x031F)
        frame_cmd_rom[0]  = {1'b0, 1'b0, 16'h002A};
        frame_cmd_rom[1]  = {1'b0, 1'b1, 16'h0000};
        frame_cmd_rom[2]  = {1'b0, 1'b1, 16'h0000};
        frame_cmd_rom[3]  = {1'b0, 1'b1, 16'h0003};
        frame_cmd_rom[4]  = {1'b0, 1'b1, 16'h001F};
        // 5..9: Set Page Address 0..479 (0x0000 .. 0x01DF)
        frame_cmd_rom[5]  = {1'b0, 1'b0, 16'h002B};
        frame_cmd_rom[6]  = {1'b0, 1'b1, 16'h0000};
        frame_cmd_rom[7]  = {1'b0, 1'b1, 16'h0000};
        frame_cmd_rom[8]  = {1'b0, 1'b1, 16'h0001};
        frame_cmd_rom[9]  = {1'b0, 1'b1, 16'h00DF};
        // 10: Memory Write Start (0x002C)
        frame_cmd_rom[10] = {1'b0, 1'b0, 16'h002C};
    end

    // ------------------------------------------------------------------------
    // Master State Machine Definition
    // ------------------------------------------------------------------------
    localparam S_HW_RST_START = 4'd0;
    localparam S_HW_RST_LOW   = 4'd1;
    localparam S_HW_RST_HIGH  = 4'd2;
    localparam S_READ_PID_CMD = 4'd3;
    localparam S_READ_PID_DAT = 4'd4;
    localparam S_INIT_STEP    = 4'd5;
    localparam S_INIT_WRITE   = 4'd6;
    localparam S_INIT_DELAY   = 4'd7;
    localparam S_PREPARE_FRAME= 4'd8;
    localparam S_FRAME_CMD    = 4'd9;
    localparam S_FRAME_PIXELS = 4'd10;
    localparam S_FRAME_END    = 4'd11;
    localparam S_FRAME_WAIT   = 4'd12;
    localparam S_CHECK_PWR_CMD= 4'd13;
    localparam S_CHECK_PWR_DAT= 4'd14;

    reg [3:0]  state;
    reg [2:0]  bus_step;    // 8080 bus sub-phase: 0=Setup, 1=Pulse, 2=Latch, 3=Hold
    reg [4:0]  bus_clk_div; // Clock divider for robust DuPont wire timing

    // Frame coordinate generators
    reg [9:0]  pixel_x;  // 0 .. 799
    reg [8:0]  pixel_y;  // 0 .. 479

    // ------------------------------------------------------------------------
    // 通路验证：整屏纯色轮换（白 -> 红 -> 绿 -> 蓝，每 16 帧换一次）
    // ------------------------------------------------------------------------
    wire [1:0] test_sel = frame_cnt[5:4];
    reg [15:0] current_pixel_color;
    always @(*) begin
        case (test_sel)
            2'd0:    current_pixel_color = 16'hFFFF;  // 白
            2'd1:    current_pixel_color = 16'hF800;  // 红
            2'd2:    current_pixel_color = 16'h07E0;  // 绿
            default: current_pixel_color = 16'h001F;  // 蓝
        endcase
    end

    // ------------------------------------------------------------------------
    // Main Control FSM (Rock-solid DuPont Wire Timing)
    // ------------------------------------------------------------------------
    always @(posedge sys_clk or negedge rst_n) begin
        if (!rst_n) begin
            state           <= S_HW_RST_START;
            bus_step        <= 3'd0;
            bus_clk_div     <= 5'd0;
            init_idx        <= 7'd0;
            frame_cmd_idx   <= 4'd0;
            pixel_x         <= 10'd0;
            pixel_y         <= 9'd0;
            frame_cnt       <= 6'd0;
            init_done_reg   <= 1'b0;
            frame_pulse_reg <= 1'b0;
            wr_activity_reg <= 1'b0;
            lcd_cs          <= 1'b1;
            lcd_rs          <= 1'b1;
            lcd_wr          <= 1'b1;
            lcd_rd          <= 1'b1;
            lcd_rst         <= 1'b0;
            lcd_db_out      <= 16'd0;
            lcd_db_oe       <= 1'b1;
            delay_load_en   <= 1'b0;
            delay_load_val  <= 24'd0;
            read_idx        <= 3'd0;
            pid_byte0       <= 8'd0;
            pid_byte1       <= 8'd0;
            pid_byte2       <= 8'd0;
            pid_byte3       <= 8'd0;
            pid_byte4       <= 8'd0;
            detected_pid    <= 8'd0;
            pid_match       <= 1'b0;
            power_mode_reg  <= 8'd0;
        end else begin
            delay_load_en <= 1'b0; // Default pulse
            
            case (state)
                // 1. Hardware Reset Start: Hold RST low for 20ms
                S_HW_RST_START: begin
                    lcd_rst        <= 1'b0;
                    lcd_cs         <= 1'b1;
                    lcd_wr         <= 1'b1;
                    lcd_rd         <= 1'b1;
                    lcd_rs         <= 1'b1;
                    lcd_db_oe      <= 1'b1;
                    delay_load_val <= 24'd1000000; // 20ms
                    delay_load_en  <= 1'b1;
                    state          <= S_HW_RST_LOW;
                end

                // 2. Hardware Reset LOW Wait
                S_HW_RST_LOW: begin
                    lcd_rst <= 1'b0;
                    if (delay_done) begin
                        lcd_rst        <= 1'b1;
                        delay_load_val <= 24'd2000000; // 40ms RST HIGH recovery
                        delay_load_en  <= 1'b1;
                        state          <= S_HW_RST_HIGH;
                    end
                end

                // 3. Hardware Reset HIGH Wait
                S_HW_RST_HIGH: begin
                    lcd_rst <= 1'b1;
                    if (delay_done) begin
                        bus_step    <= 3'd0;
                        bus_clk_div <= 5'd0;
                        state       <= S_READ_PID_CMD;
                    end
                end

                // 4. Closed-loop Check: Write Command 0xA1 (read_ddb)
                S_READ_PID_CMD: begin
                    case (bus_step)
                        3'd0: begin
                            // Phase 0: Setup CMD 0xA1 with CS=0
                            lcd_cs     <= 1'b0;
                            lcd_rs     <= 1'b0; // CMD
                            lcd_wr     <= 1'b1;
                            lcd_rd     <= 1'b1;
                            lcd_db_out <= 16'h00A1;
                            lcd_db_oe  <= 1'b1;
                            if (bus_clk_div < 5'd4) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd1;
                            end
                        end
                        3'd1: begin
                            // Phase 1: Drive WR LOW (100ns)
                            lcd_wr <= 1'b0;
                            if (bus_clk_div < 5'd5) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd2;
                            end
                        end
                        3'd2: begin
                            // Phase 2: Rising edge of WR latches 0xA1
                            lcd_wr <= 1'b1;
                            if (bus_clk_div < 5'd4) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd3;
                            end
                        end
                        3'd3: begin
                            // Phase 3: Switch bus to High-Z for read
                            lcd_wr      <= 1'b1;
                            lcd_db_oe   <= 1'b0; // FPGA High-Z
                            read_idx    <= 3'd0;
                            bus_step    <= 3'd0;
                            bus_clk_div <= 5'd0;
                            state       <= S_READ_PID_DAT;
                        end
                    endcase
                end

                // 5. Closed-loop Check: Read all 5 DDB Bytes per SSD1963 spec
                // Byte 0: SSL_H (0x01)
                // Byte 1: SSL_L (0x57)
                // Byte 2: Product ID (0x61)
                // Byte 3: Revision code (0x01)
                // Byte 4: Exit code (0xFF)
                S_READ_PID_DAT: begin
                    case (bus_step)
                        3'd0: begin
                            // Setup Read: CS=0, RS=1 (Data), RD=1, WR=1, High-Z
                            lcd_cs    <= 1'b0;
                            lcd_rs    <= 1'b1; // DAT
                            lcd_rd    <= 1'b1;
                            lcd_wr    <= 1'b1;
                            lcd_db_oe <= 1'b0; // High-Z
                            if (bus_clk_div < 5'd5) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd1;
                            end
                        end
                        3'd1: begin
                            // Assert RD LOW for 20 cycles = 400ns
                            lcd_rd <= 1'b0;
                            if (bus_clk_div < 5'd19) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd2;
                            end
                        end
                        3'd2: begin
                            // Rising edge of RD: Latch incoming data!
                            lcd_rd <= 1'b1;
                            case (read_idx)
                                3'd0: pid_byte0 <= lcd_db_in[7:0];
                                3'd1: pid_byte1 <= lcd_db_in[7:0];
                                3'd2: pid_byte2 <= lcd_db_in[7:0];
                                3'd3: pid_byte3 <= lcd_db_in[7:0];
                                3'd4: pid_byte4 <= lcd_db_in[7:0];
                            endcase
                            if (bus_clk_div < 5'd10) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd3;
                            end
                        end
                        3'd3: begin
                            // Hold RD HIGH for 10 cycles = 200ns
                            lcd_rd <= 1'b1;
                            if (read_idx < 3'd4) begin
                                read_idx    <= read_idx + 1'b1;
                                bus_step    <= 3'd0;
                                bus_clk_div <= 5'd0;
                            end else begin
                                // All 5 bytes cleanly read!
                                lcd_cs       <= 1'b1; // Pulse CS HIGH after transaction
                                lcd_db_oe    <= 1'b1; // restore FPGA driving bus
                                detected_pid <= pid_byte2;
                                pid_match    <= (pid_byte2 == 8'h61);
                                
                                if (pid_byte2 == 8'h61) begin
                                    init_idx     <= 7'd0;
                                    bus_step     <= 3'd0;
                                    bus_clk_div  <= 5'd0;
                                    state        <= S_INIT_STEP;
                                end else begin
                                    // PID retry after 10ms
                                    delay_load_val <= 24'd500000;
                                    delay_load_en  <= 1'b1;
                                    state          <= S_HW_RST_HIGH;
                                end
                            end
                        end
                    endcase
                end

                // 6. Init ROM Sequencer
                S_INIT_STEP: begin
                    if (init_idx >= INIT_LEN) begin
                        init_done_reg <= 1'b1;
                        state         <= S_PREPARE_FRAME;
                    end else if (init_rom[init_idx][31]) begin
                        // Is delay entry
                        delay_load_val <= init_rom[init_idx][23:0];
                        delay_load_en  <= 1'b1;
                        state          <= S_INIT_DELAY;
                    end else begin
                        // Bus write command or data
                        bus_step    <= 3'd0;
                        bus_clk_div <= 5'd0;
                        state       <= S_INIT_WRITE;
                    end
                end

                // 7. Init ROM Bus Write: Clean 4-phase write with full setup/hold
                S_INIT_WRITE: begin
                    case (bus_step)
                        3'd0: begin
                            // Phase 0: Setup RS & DB while WR is HIGH
                            lcd_cs     <= 1'b0;
                            lcd_rs     <= init_rom[init_idx][30];
                            lcd_db_out <= init_rom[init_idx][15:0];
                            lcd_db_oe  <= 1'b1;
                            lcd_wr     <= 1'b1;
                            lcd_rd     <= 1'b1;
                            if (bus_clk_div < 5'd3) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd1;
                            end
                        end
                        3'd1: begin
                            // Phase 1: Assert WR LOW (100ns)
                            lcd_wr <= 1'b0;
                            if (bus_clk_div < 5'd4) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd2;
                            end
                        end
                        3'd2: begin
                            // Phase 2: Rising edge of WR latches data
                            lcd_wr <= 1'b1;
                            if (bus_clk_div < 5'd3) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd3;
                            end
                        end
                        3'd3: begin
                            // Phase 3: Toggle CS HIGH between commands for clean edges
                            lcd_wr   <= 1'b1;
                            lcd_cs   <= 1'b1;
                            init_idx <= init_idx + 1'b1;
                            state    <= S_INIT_STEP;
                        end
                    endcase
                end

                // 8. Delay Execution State
                S_INIT_DELAY: begin
                    lcd_cs <= 1'b1;
                    if (delay_done) begin
                        init_idx <= init_idx + 1'b1;
                        state    <= S_INIT_STEP;
                    end
                end

                // 9. Prepare to draw a new frame
                S_PREPARE_FRAME: begin
                    frame_cmd_idx <= 4'd0;
                    bus_step      <= 3'd0;
                    bus_clk_div   <= 5'd0;
                    state         <= S_FRAME_CMD;
                end

                // 10. Send Frame Address Window Commands (0x2A, 0x2B, 0x2C)
                S_FRAME_CMD: begin
                    case (bus_step)
                        3'd0: begin
                            lcd_cs     <= 1'b0;
                            lcd_rs     <= frame_cmd_rom[frame_cmd_idx][16];
                            lcd_db_out <= frame_cmd_rom[frame_cmd_idx][15:0];
                            lcd_db_oe  <= 1'b1;
                            lcd_wr     <= 1'b1;
                            lcd_rd     <= 1'b1;
                            if (bus_clk_div < 5'd3) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd1;
                            end
                        end
                        3'd1: begin
                            lcd_wr <= 1'b0; // WR LOW pulse
                            if (bus_clk_div < 5'd4) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd2;
                            end
                        end
                        3'd2: begin
                            lcd_wr <= 1'b1; // Rising edge latch
                            if (bus_clk_div < 5'd3) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd3;
                            end
                        end
                        3'd3: begin
                            lcd_wr <= 1'b1;
                            lcd_cs <= 1'b1; // Clean CS cycle
                            if (frame_cmd_idx >= 4'd10) begin
                                pixel_x     <= 10'd0;
                                pixel_y     <= 9'd0;
                                bus_step    <= 3'd0;
                                bus_clk_div <= 5'd0;
                                state       <= S_FRAME_PIXELS;
                            end else begin
                                frame_cmd_idx <= frame_cmd_idx + 1'b1;
                                bus_step      <= 3'd0;
                                bus_clk_div   <= 5'd0;
                            end
                        end
                    endcase
                end

                // 11. Stream 800x480 RGB565 Pixels (Gentle 320ns cycle for zero DuPont crosstalk)
                S_FRAME_PIXELS: begin
                    case (bus_step)
                        3'd0: begin
                            lcd_cs     <= 1'b0;
                            lcd_rs     <= 1'b1; // DATA mode
                            lcd_db_out <= current_pixel_color;
                            lcd_db_oe  <= 1'b1;
                            lcd_wr     <= 1'b1;
                            lcd_rd     <= 1'b1;
                            if (bus_clk_div < 5'd4) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd1;
                            end
                        end
                        3'd1: begin
                            lcd_wr          <= 1'b0; // Pulse LOW (120ns)
                            wr_activity_reg <= ~wr_activity_reg;
                            if (bus_clk_div < 5'd5) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd2;
                            end
                        end
                        3'd2: begin
                            lcd_wr <= 1'b1; // Rising edge latch (80ns)
                            if (bus_clk_div < 5'd3) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd3;
                            end
                        end
                        3'd3: begin
                            lcd_wr      <= 1'b1;
                            bus_step    <= 3'd0;
                            bus_clk_div <= 5'd0;
                            
                            // Advance pixel coordinates
                            if (pixel_x < 10'd799) begin
                                pixel_x <= pixel_x + 1'b1;
                            end else begin
                                pixel_x <= 10'd0;
                                if (pixel_y < 9'd479) begin
                                    pixel_y <= pixel_y + 1'b1;
                                end else begin
                                    // Full frame finished!
                                    lcd_cs          <= 1'b1;
                                    frame_pulse_reg <= ~frame_pulse_reg;
                                    frame_cnt       <= frame_cnt + 1'b1;
                                    state           <= S_FRAME_END;
                                end
                            end
                        end
                    endcase
                end

                // 12. Frame End
                S_FRAME_END: begin
                    lcd_cs         <= 1'b1;
                    delay_load_val <= 24'd100000; // ~2ms inter-frame gap
                    delay_load_en  <= 1'b1;
                    state          <= S_FRAME_WAIT;
                end

                // 13. Wait for inter-frame delay, then verify SSD1963 Power Mode (0x0A)
                S_FRAME_WAIT: begin
                    lcd_cs <= 1'b1;
                    if (delay_done) begin
                        bus_step    <= 3'd0;
                        bus_clk_div <= 5'd0;
                        state       <= S_CHECK_PWR_CMD;
                    end
                end

                // 14. Closed-loop Health Check: Write Command 0x0A (get_power_mode)
                // Unlike 0xA1 (which returns 0x61 even after a reset when PLL is OFF),
                // 0x0A returns 0x1C (Sleep OFF=1, Normal=1, Display ON=1) ONLY when
                // SSD1963 is actively initialized, and returns 0x08 if it ever reset!
                S_CHECK_PWR_CMD: begin
                    case (bus_step)
                        3'd0: begin
                            lcd_cs     <= 1'b0;
                            lcd_rs     <= 1'b0; // CMD
                            lcd_wr     <= 1'b1;
                            lcd_rd     <= 1'b1;
                            lcd_db_out <= 16'h000A;
                            lcd_db_oe  <= 1'b1;
                            if (bus_clk_div < 5'd4) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd1;
                            end
                        end
                        3'd1: begin
                            lcd_wr <= 1'b0;
                            if (bus_clk_div < 5'd5) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd2;
                            end
                        end
                        3'd2: begin
                            lcd_wr <= 1'b1;
                            if (bus_clk_div < 5'd4) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd3;
                            end
                        end
                        3'd3: begin
                            lcd_wr      <= 1'b1;
                            lcd_db_oe   <= 1'b0; // High-Z for readback
                            bus_step    <= 3'd0;
                            bus_clk_div <= 5'd0;
                            state       <= S_CHECK_PWR_DAT;
                        end
                    endcase
                end

                // 15. Read 1 Byte Parameter of 0x0A (get_power_mode)
                S_CHECK_PWR_DAT: begin
                    case (bus_step)
                        3'd0: begin
                            lcd_cs    <= 1'b0;
                            lcd_rs    <= 1'b1; // DAT
                            lcd_rd    <= 1'b1;
                            lcd_wr    <= 1'b1;
                            lcd_db_oe <= 1'b0; // High-Z
                            if (bus_clk_div < 5'd5) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd1;
                            end
                        end
                        3'd1: begin
                            lcd_rd <= 1'b0; // Assert RD LOW (400ns)
                            if (bus_clk_div < 5'd19) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                // Latch data WHILE RD is still LOW right before rising edge!
                                power_mode_reg <= lcd_db_in[7:0];
                                bus_clk_div    <= 5'd0;
                                bus_step       <= 3'd2;
                            end
                        end
                        3'd2: begin
                            lcd_rd <= 1'b1;
                            if (bus_clk_div < 5'd10) begin
                                bus_clk_div <= bus_clk_div + 1'b1;
                            end else begin
                                bus_clk_div <= 5'd0;
                                bus_step    <= 3'd3;
                            end
                        end
                        3'd3: begin
                            lcd_rd    <= 1'b1;
                            lcd_cs    <= 1'b1;
                            lcd_db_oe <= 1'b1;
                            // Bit[2] = Display ON (1 when active, 0 if reset to POR 0x08)
                            if (power_mode_reg[2]) begin
                                state <= S_PREPARE_FRAME;
                            end else begin
                                // SSD1963 reset or lost init! Immediately re-run init_rom!
                                init_idx    <= 7'd0;
                                bus_step    <= 3'd0;
                                bus_clk_div <= 5'd0;
                                state       <= S_INIT_STEP;
                            end
                        end
                    endcase
                end

                default: state <= S_HW_RST_START;
            endcase
        end
    end

endmodule
