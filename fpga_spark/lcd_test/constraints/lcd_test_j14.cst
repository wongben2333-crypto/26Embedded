// Tang Mega 138K NEO Dock 31005 + ATK-MD0700 SSD1963 8080 LCD via J14 + PT8211 Audio
// Device: GW5AST-LV138PG484AC1/I0 (GW5AST-138C)

// Clock & Reset
IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "sys_rst_n" AA13;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Board user keys
IO_LOC "key" AB13;
IO_PORT "key" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "key2" Y12;
IO_PORT "key2" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// Board LEDs
IO_LOC "led[0]" T18;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[1]" R18;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[2]" R17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[3]" P16;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// Board PT8211 16-bit I2S Audio DAC (3.5mm Headphone Jack & 3W Speakers)
IO_LOC "HP_BCK" Y17;
IO_PORT "HP_BCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "HP_WS" AB17;
IO_PORT "HP_WS" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "HP_DIN" AA16;
IO_PORT "HP_DIN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "PA_EN" AB16;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// UART (FT2232H Channel B - COM8/COM9, 115200 8N1)
IO_LOC "uart_tx" U15;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "uart_rx" V14;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Board RGB WS2812 & DPI dummy backlight
IO_LOC "ws_dout" J16;
IO_PORT "ws_dout" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "lcd_dpi_bl" P20;
IO_PORT "lcd_dpi_bl" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4;

// LCD control: LCD pin -> J14 pin -> FPGA ball
IO_LOC "lcd_cs"  AB21; // LCD_CS  -> J14-24
IO_PORT "lcd_cs"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "lcd_rs"  R14;  // LCD_RS  -> J14-39
IO_PORT "lcd_rs"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "lcd_wr"  AB20; // LCD_WR  -> J14-27
IO_PORT "lcd_wr"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "lcd_rd"  AB18; // LCD_RD  -> J14-30
IO_PORT "lcd_rd"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "lcd_rst" Y18;  // LCD_RST -> J14-32
IO_PORT "lcd_rst" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// LCD data: LCD pin -> J14 pin -> FPGA ball
IO_LOC "lcd_db[0]"  V20;  // D0  -> J14-19
IO_LOC "lcd_db[1]"  U20;  // D1  -> J14-20
IO_LOC "lcd_db[2]"  Y22;  // D2  -> J14-21
IO_LOC "lcd_db[3]"  AA20; // D3  -> J14-26
IO_LOC "lcd_db[4]"  N15;  // D4  -> J14-34 (SDRAM1_BA0)
IO_LOC "lcd_db[5]"  U17;  // D5  -> J14-36 (SDRAM1_A10)
IO_LOC "lcd_db[6]"  P14;  // D6  -> J14-40 (SDRAM1_A3)
IO_LOC "lcd_db[7]"  P15;  // D7  -> J14-38 (SDRAM1_A1)
IO_LOC "lcd_db[8]"  N13;  // D8  -> J14-18
IO_LOC "lcd_db[9]"  N14;  // D9  -> J14-17
IO_LOC "lcd_db[10]" AA21; // D10 -> J14-25
IO_LOC "lcd_db[11]" P17;  // D11 -> J14-15
IO_LOC "lcd_db[12]" W21;  // D12 -> J14-14
IO_LOC "lcd_db[13]" W22;  // D13 -> J14-13
IO_LOC "lcd_db[14]" V17;  // D14 -> J14-10
IO_LOC "lcd_db[15]" AB22; // D15 -> J14-23

IO_PORT "lcd_db[0]"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_db[1]"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_db[2]"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_db[3]"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_db[4]"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_db[5]"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_db[6]"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_db[7]"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_db[8]"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_db[9]"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_db[10]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_db[11]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_db[12]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_db[13]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_db[14]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_db[15]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
